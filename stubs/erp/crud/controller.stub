<?php

namespace Modules\{{ module }}\Http\Controllers;

use App\Models\User;
use DomainException;
use Illuminate\Contracts\View\View;
use Illuminate\Database\QueryException;
use Illuminate\Http\JsonResponse;
use Illuminate\Http\Request;
use Illuminate\Routing\Controller;
use Illuminate\Support\Str;
use Illuminate\Validation\ValidationException;
use Modules\{{ module }}\DataTables\{{ dataTable }};
use Modules\{{ module }}\Http\Requests\{{ bulkRequest }};
use Modules\{{ module }}\Http\Requests\{{ settingsRequest }};
use Modules\{{ module }}\Http\Requests\{{ storeRequest }};
use Modules\{{ module }}\Http\Requests\{{ updateRequest }};
use Modules\{{ module }}\Models\{{ model }};
use Modules\{{ module }}\Services\{{ documentSettingsService }};
use Modules\{{ module }}\Services\{{ service }};
use Modules\Core\Services\ActivityLogger;
use Modules\Core\Services\ActivityLogProperties;
use Modules\Core\Services\BreadcrumbService;
use Modules\Core\Services\SettingService;
use Throwable;

class {{ controller }} extends Controller
{
    public function __construct(
        private readonly {{ service }} $records,
        private readonly ActivityLogger $activityLogger,
        private readonly BreadcrumbService $breadcrumbs,
    ) {}

    public function index(Request $request, {{ documentSettingsService }} $documentNumberSettings): View
    {
        $this->logActivity($request, '{{ permissionPrefix }}.index');

        return view('{{ viewPath }}.index', [
            'breadcrumbs' => $this->breadcrumbs->forMenuRoute('{{ routePrefix }}.index'),
            'documentNumberSettings' => $documentNumberSettings->current(),
        ]);
    }

    public function data(Request $request, {{ dataTable }} $dataTable): JsonResponse
    {
        return $dataTable->json($request);
    }

    public function create(): View
    {
        return $this->formView('create');
    }

    public function show(Request $request, {{ model }} ${{ variable }}): View
    {
        $this->abortIfTrashedRecordIsNotViewable($request, ${{ variable }});

        $this->logActivity($request, '{{ permissionPrefix }}.view', $this->recordPublicProperties(${{ variable }}));

        return $this->formView('view', ${{ variable }});
    }

    public function edit({{ model }} ${{ variable }}): View
    {
        return $this->formView('edit', ${{ variable }});
    }

    public function clone({{ model }} ${{ variable }}): View
    {
        $cloneSourceToken = (string) Str::uuid();
        session()->put($this->cloneSourceSessionKey($cloneSourceToken), ${{ variable }}->doc_num);

        return $this->formView('clone', ${{ variable }}, $cloneSourceToken);
    }

    public function store({{ storeRequest }} $request): JsonResponse
    {
        $submitAction = $this->submitAction($request, creating: true);
        $this->authorizeSubmitAction($request, $submitAction, cloning: $request->filled('clone_source_token'));
        $cloneSource = $this->cloneSourceFromRequest($request);

        try {
            $result = $this->records->create($request->validated());
        } catch (QueryException $exception) {
            $this->throwValidationExceptionIfUniqueConflict($exception);

            throw $exception;
        } catch (DomainException $exception) {
            return $this->domainError($exception);
        }

        $record = $result['record'];

        if ($cloneSource instanceof {{ model }}) {
            $this->logActivity($request, '{{ permissionPrefix }}.clone', ActivityLogProperties::crudCloned(
                '{{ permissionPrefix }}',
                ActivityLogProperties::record('{{ permissionPrefix }}', $cloneSource->{{ displayField }}, $cloneSource->doc_num),
                $record->{{ displayField }},
                $record->doc_num,
                $this->submitActionProperties($request, creating: true),
            ));
        } else {
            $this->logActivity($request, '{{ permissionPrefix }}.create', ActivityLogProperties::crudCreated(
                '{{ permissionPrefix }}',
                $record->{{ displayField }},
                $record->doc_num,
                $this->submitActionProperties($request, creating: true),
            ));
        }

        return response()->json([
            'success' => true,
            'message' => $cloneSource instanceof {{ model }} ? __('{{ translationKey }}.messages.cloned') : __('{{ translationKey }}.messages.created'),
            ...$this->saveActionResponse($request, $record, 'store'),
            'data' => [
                'doc_num' => $record->doc_num,
                'doc_number' => $record->doc_number,
                'urls' => $this->recordUrls($record),
            ],
        ]);
    }

    public function update({{ updateRequest }} $request, {{ model }} ${{ variable }}): JsonResponse
    {
        $this->authorizeSubmitAction($request, $this->submitAction($request));

        try {
            $result = $this->records->update(${{ variable }}, $request->validated());
        } catch (QueryException $exception) {
            $this->throwValidationExceptionIfUniqueConflict($exception);

            throw $exception;
        } catch (DomainException $exception) {
            return $this->domainError($exception);
        }

        $record = $result['record'];

        if (! $result['changed']) {
            return response()->json([
                'success' => false,
                'type' => 'no_changes',
                'message' => __('common.messages.no_changes'),
            ]);
        }

        $this->logActivity($request, '{{ permissionPrefix }}.update', ActivityLogProperties::crudUpdated(
            '{{ permissionPrefix }}',
            $record->{{ displayField }},
            $record->doc_num,
            $result['changes'],
            $this->submitActionProperties($request),
        ));

        if (in_array('doc_number', $result['changed_fields'], true)) {
            $this->logActivity($request, '{{ permissionPrefix }}.doc_number.changed', ActivityLogProperties::documentNumberChanged(
                '{{ permissionPrefix }}',
                $record->{{ displayField }},
                $result['old_doc_number'],
                $result['old_doc_num'],
                $record->doc_number,
                $record->doc_num,
            ));
        }

        return response()->json([
            'success' => true,
            'message' => __('{{ translationKey }}.messages.updated'),
            ...$this->saveActionResponse($request, $record, 'update'),
            'data' => [
                'old_doc_number' => $result['old_doc_number'],
                'old_doc_num' => $result['old_doc_num'],
                'doc_number' => $record->doc_number,
                'doc_num' => $record->doc_num,
                'urls' => $this->recordUrls($record),
            ],
        ]);
    }

    public function destroy(Request $request, {{ model }} ${{ variable }}): JsonResponse
    {
        try {
            $this->records->delete(${{ variable }});
        } catch (DomainException $exception) {
            $this->logActivity($request, '{{ permissionPrefix }}.delete_blocked', $this->recordPublicProperties(${{ variable }}), 'blocked');

            return $this->domainError($exception);
        }

        $this->logActivity($request, '{{ permissionPrefix }}.delete', ActivityLogProperties::crudDeleted(
            '{{ permissionPrefix }}',
            ${{ variable }}->{{ displayField }},
            ${{ variable }}->doc_num,
        ));

        return response()->json([
            'success' => true,
            'message' => __('{{ translationKey }}.messages.deleted'),
        ]);
    }

    public function bulkDelete({{ bulkRequest }} $request): JsonResponse
    {
        try {
            $docNums = $request->validated()['doc_nums'];
            $deleted = $this->records->bulkDelete($docNums);
        } catch (DomainException $exception) {
            return $this->domainError($exception);
        }

        $this->logActivity($request, '{{ permissionPrefix }}.bulk_delete', ActivityLogProperties::bulkDeleted(
            '{{ permissionPrefix }}',
            $deleted,
            $docNums,
        ));

        return response()->json([
            'success' => true,
            'message' => __('{{ translationKey }}.messages.bulk_deleted', ['count' => $deleted]),
            'data' => [
                'deleted' => $deleted,
            ],
        ]);
    }

    public function restore(Request $request, string ${{ routeParameter }}): JsonResponse
    {
        $record = $this->restoreRecordByDocNum(${{ routeParameter }});

        try {
            $record = $this->records->restore($record);
        } catch (DomainException $exception) {
            return $this->domainError($exception);
        }

        $this->logActivity($request, '{{ permissionPrefix }}.restore', ActivityLogProperties::crudRestored(
            '{{ permissionPrefix }}',
            $record->{{ displayField }},
            $record->doc_num,
            $this->recordRestoreProperties($request, $record),
        ));

        return response()->json([
            'success' => true,
            'message' => __('{{ translationKey }}.messages.restored'),
        ]);
    }

    public function updateDocumentNumberSettings(
        {{ settingsRequest }} $request,
        {{ documentSettingsService }} $documentNumberSettings
    ): JsonResponse {
        $result = $documentNumberSettings->update(
            $request->validated('prefix'),
            (int) $request->validated('padding'),
        );

        $this->logActivity($request, '{{ permissionPrefix }}.document_number_settings.update', ActivityLogProperties::settingsUpdated(
            '{{ permissionPrefix }}',
            [
                'prefix' => [
                    'old' => $result['old']['prefix'],
                    'new' => $result['new']['prefix'],
                ],
                'padding' => [
                    'old' => $result['old']['padding'],
                    'new' => $result['new']['padding'],
                ],
            ],
        ));

        return response()->json([
            'success' => true,
            'message' => __('{{ translationKey }}.document_number_settings.updated_successfully'),
            'data' => $result['new'],
        ]);
    }

    private function formView(string $mode, ?{{ model }} $record = null, ?string $cloneSourceToken = null): View
    {
        $documentNumberSettings = app({{ documentSettingsService }}::class)->current();

        return view('{{ viewPath }}.form', [
            'mode' => $mode,
            '{{ variable }}' => $record,
            'action' => in_array($mode, ['create', 'clone'], true) ? route('{{ routePrefix }}.store') : route('{{ routePrefix }}.update', $record?->doc_num),
            'method' => in_array($mode, ['create', 'clone'], true) ? 'POST' : 'PUT',
            'documentNumberPrefix' => $documentNumberSettings['prefix'],
            'documentNumberPadding' => $documentNumberSettings['padding'],
            'canControlDocumentNumber' => (bool) auth()->user()?->can('{{ permissionPrefix }}.document_number.control'),
            'metadata' => $this->metadata($record),
            'breadcrumbs' => $this->breadcrumbs($mode, $record),
            'cloneSourceToken' => $cloneSourceToken,
        ]);
    }

    /**
     * @return array<string, string>
     */
    private function recordUrls({{ model }} $record): array
    {
        return [
            'show' => route('{{ routePrefix }}.show', $record->doc_num),
            'clone' => route('{{ routePrefix }}.clone', $record->doc_num),
            'edit' => route('{{ routePrefix }}.edit', $record->doc_num),
            'update' => route('{{ routePrefix }}.update', $record->doc_num),
            'destroy' => route('{{ routePrefix }}.destroy', $record->doc_num),
            'restore' => route('{{ routePrefix }}.restore', $record->doc_num),
        ];
    }

    /**
     * @return array<string, mixed>
     */
    private function saveActionResponse(Request $request, {{ model }} $record, string $operation): array
    {
        $action = $this->submitAction($request, creating: $operation === 'store');
        $response = ['submit_action' => $action];

        $redirect = match ($action) {
            'save_view' => route('{{ routePrefix }}.show', $record->doc_num),
            'save_edit' => route('{{ routePrefix }}.edit', $record->doc_num),
            'save_back' => route('{{ routePrefix }}.index'),
            'save_clone' => route('{{ routePrefix }}.clone', $record->doc_num),
            default => $operation === 'store' ? $this->redirectAfterStore($request, $record) : null,
        };

        if ($redirect) {
            $response['redirect'] = $redirect;
        }

        return $response;
    }

    private function authorizeSubmitAction(Request $request, string $action, bool $cloning = false): void
    {
        $permission = match ($action) {
            'save_view' => '{{ permissionPrefix }}.view',
            'save_edit' => '{{ permissionPrefix }}.edit',
            'save_back' => '{{ permissionPrefix }}.view',
            'save_clone' => '{{ permissionPrefix }}.clone',
            default => null,
        };

        abort_if($permission !== null && ! $request->user()?->can($permission), 403, __('{{ translationKey }}.messages.action_forbidden'));
    }

    private function submitAction(Request $request, bool $creating = false): string
    {
        $action = $request->string('submit_action')->trim()->toString() ?: 'save';

        if ($creating && $action === 'save') {
            return 'save_new';
        }

        if ($action === 'save_new' || (! $creating && $action === 'save_edit')) {
            return 'save';
        }

        return in_array($action, ['save', 'save_view', 'save_edit', 'save_back', 'save_clone'], true) ? $action : 'save';
    }

    /**
     * @return array{submit_action?: string}
     */
    private function submitActionProperties(Request $request, bool $creating = false): array
    {
        $rawAction = $request->string('submit_action')->trim()->toString();

        if ($rawAction === '' && ! $creating) {
            return [];
        }

        return ['submit_action' => $this->submitAction($request, creating: $creating)];
    }

    private function redirectAfterStore(Request $request, {{ model }} $record): string
    {
        if ($request->user()?->can('{{ permissionPrefix }}.edit')) {
            return route('{{ routePrefix }}.edit', $record->doc_num);
        }

        if ($request->user()?->can('{{ permissionPrefix }}.view')) {
            return route('{{ routePrefix }}.show', $record->doc_num);
        }

        return route('{{ routePrefix }}.index');
    }

    private function cloneSourceFromRequest({{ storeRequest }} $request): ?{{ model }}
    {
        $cloneSourceToken = $request->string('clone_source_token')->trim()->toString();

        if ($cloneSourceToken === '') {
            return null;
        }

        abort_unless((bool) $request->user()?->can('{{ permissionPrefix }}.clone'), 403);

        $sourceDocNum = (string) $request->session()->pull($this->cloneSourceSessionKey($cloneSourceToken), '');

        if ($sourceDocNum === '') {
            throw ValidationException::withMessages([
                '{{ displayField }}' => __('{{ translationKey }}.messages.clone_not_allowed'),
            ]);
        }

        $sourceRecord = {{ model }}::query()
            ->where('doc_num', $sourceDocNum)
            ->first();

        if (! $sourceRecord instanceof {{ model }}) {
            throw ValidationException::withMessages([
                '{{ displayField }}' => __('{{ translationKey }}.messages.clone_not_allowed'),
            ]);
        }

        return $sourceRecord;
    }

    private function cloneSourceSessionKey(string $token): string
    {
        return '{{ permissionPrefix }}.clone_sources.'.$token;
    }

    private function restoreRecordByDocNum(string $docNum): {{ model }}
    {
        return {{ model }}::onlyTrashed()
            ->where('doc_num', $docNum)
            ->latest('deleted_at')
            ->first()
            ?? {{ model }}::query()
                ->where('doc_num', $docNum)
                ->firstOrFail();
    }

    private function abortIfTrashedRecordIsNotViewable(Request $request, {{ model }} $record): void
    {
        abort_if(
            $record->trashed() && ! $request->user()?->can('{{ permissionPrefix }}.view_trashed'),
            404,
        );
    }

    /**
     * @return array<string, string|null>
     */
    private function recordRestoreProperties(Request $request, {{ model }} $record): array
    {
        $user = $request->user();

        return [
            ...$this->recordPublicProperties($record),
            'restored_by_user_doc_num' => $user instanceof User ? $user->doc_num : null,
            'restored_at' => $record->restored_at?->toJSON() ?? now()->toJSON(),
        ];
    }

    /**
     * @return array<string, string|null>
     */
    private function metadata(?{{ model }} $record): array
    {
        if (! $record) {
            return [
                'created_by' => null,
                'created_at' => null,
                'updated_by' => null,
                'updated_at' => null,
                'deleted_by' => null,
                'deleted_at' => null,
                'restored_by' => null,
                'restored_at' => null,
            ];
        }

        $record->loadMissing(['createdBy:id,name,doc_num', 'updatedBy:id,name,doc_num', 'deletedBy:id,name,doc_num', 'restoredBy:id,name,doc_num']);
        $settings = app(SettingService::class);

        return [
            'created_by' => $this->auditUserLabel($record->createdBy),
            'created_at' => $settings->formatDateTime($record->created_at, ''),
            'updated_by' => $this->auditUserLabel($record->updatedBy),
            'updated_at' => $settings->formatDateTime($record->updated_at, ''),
            'deleted_by' => $this->auditUserLabel($record->deletedBy),
            'deleted_at' => $settings->formatDateTime($record->deleted_at, ''),
            'restored_by' => $this->auditUserLabel($record->restoredBy),
            'restored_at' => $settings->formatDateTime($record->restored_at, ''),
        ];
    }

    private function auditUserLabel(?User $user): ?string
    {
        if (! $user) {
            return null;
        }

        return trim(implode(' / ', array_filter([$user->name, $user->doc_num])));
    }

    /**
     * @return array<int, array{label: string, url: string|null, active: bool}>
     */
    private function breadcrumbs(string $mode, ?{{ model }} $record): array
    {
        $extra = match ($mode) {
            'create' => [
                ['label' => __('breadcrumb.create')],
            ],
            'clone' => [
                [
                    'label' => (string) $record?->doc_num,
                    'url' => $record ? route('{{ routePrefix }}.show', $record->doc_num) : null,
                ],
                ['label' => __('{{ translationKey }}.titles.clone')],
            ],
            'edit' => [
                [
                    'label' => (string) $record?->doc_num,
                    'url' => $record ? route('{{ routePrefix }}.show', $record->doc_num) : null,
                ],
                ['label' => __('breadcrumb.edit')],
            ],
            'view' => [
                ['label' => (string) $record?->doc_num],
            ],
            default => [],
        };

        return $this->breadcrumbs->forMenuRoute('{{ routePrefix }}.index', $extra);
    }

    private function domainError(DomainException $exception): JsonResponse
    {
        return response()->json([
            'success' => false,
            'message' => $exception->getMessage(),
        ], 422);
    }

    private function throwValidationExceptionIfUniqueConflict(QueryException $exception): void
    {
        $message = $exception->getMessage();
        $map = [
            'doc_number' => ['{{ table }}_doc_number_unique_active', '{{ table }}_doc_num_unique_active'],
{{ uniqueExceptionMap }}
        ];

        foreach ($map as $field => $needles) {
            foreach ($needles as $needle) {
                if (str_contains($message, $needle)) {
                    throw ValidationException::withMessages([
                        $field => __("{{ translationKey }}.validation.{$field}_unique"),
                    ]);
                }
            }
        }
    }

    /**
     * @return array<string, mixed>
     */
    private function recordPublicProperties({{ model }} $record): array
    {
        return [
            'doc_num' => $record->doc_num,
{{ publicProperties }}
        ];
    }

    /**
     * @param  array<string, mixed>  $properties
     */
    private function logActivity(Request $request, string $action, array $properties = [], string $status = 'success'): void
    {
        try {
            $this->activityLogger->log($request, '{{ moduleLower }}', $action, $status, [
                'properties_only' => true,
                'properties' => $properties,
            ]);
        } catch (Throwable $exception) {
            report($exception);
        }
    }
}
