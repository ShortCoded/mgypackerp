{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "laravel-boost": {
      "type": "local",
      "command": [
        "php",
        "artisan",
        "boost:mcp"
      ],
      "enabled": true,
      "timeout": 30000
    }
  },
  "permission": {
    "edit": "ask",
    "bash": "ask",
    "skill": {
      "*": "allow"
    }
  },
  "instructions": [
    "AGENTS.md",
    "CODEX_PROJECT_CONTEXT.md"
  ],
  "skills": {
    "paths": [
      ".opencode/skills"
    ]
  },
  "watcher": {
    "ignore": [
      "vendor/**",
      "node_modules/**",
      "storage/framework/**",
      "storage/logs/**",
      "public/build/**",
      ".git/**"
    ]
  }
}
