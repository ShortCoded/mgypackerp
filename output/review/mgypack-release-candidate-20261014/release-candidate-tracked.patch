+    private function syncAlternatives(
+        Product $product,
+        ProductComponent $component,
+        array $submittedAlternatives,
+    ): void {
+        $current = $component->alternatives()->lockForUpdate()->get()->keyBy('public_id');
+        $survivingPublicIds = [];
+        $seenProducts = [];
+
+        foreach ($submittedAlternatives as $index => $row) {
