APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Required in production: set an immutable release/build ID and change it on every deployment.
ASSET_VERSION=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

ERP_PHASE_MODE=legacy

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=obst_egypt
DB_USERNAME=root
DB_PASSWORD=

# PostgreSQL: use either DB_URL or the variables above — do not set both to different databases.
# If you use DB_URL, leave DB_DATABASE empty or align it with the URL to avoid connection errors.
# DB_URL="pgsql://user:pass@127.0.0.1:5432/obst_egypt"
# DB_SEARCH_PATH=public

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# Required when multiple installations share the same cache backend.
# CACHE_PREFIX=shortcoded-erp-production-

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Generate once per environment with: php artisan webpush:vapid
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Electronic invoice provider (secrets belong only in the deployment environment)
EINVOICE_ENABLED=false
EINVOICE_PROVIDER=mock
EINVOICE_ENVIRONMENT=sandbox
EINVOICE_BASE_URL=
EINVOICE_CLIENT_ID=
EINVOICE_CLIENT_SECRET=
EINVOICE_ACCESS_TOKEN=
EINVOICE_CERTIFICATE_PATH=
EINVOICE_CERTIFICATE_PASSWORD=
EINVOICE_ISSUER_TAXPAYER_ID=
EINVOICE_BRANCH_CODE=
EINVOICE_SIGNING_MODE=provider
EINVOICE_SIGNING_KEY_PATH=
EINVOICE_PAYLOAD_VERSION=1.0
EINVOICE_TIMEOUT_SECONDS=20
EINVOICE_MOCK_RESULT=accepted
